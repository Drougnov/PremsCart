# ---------- Build React frontend ----------
FROM node:22-alpine AS frontend
WORKDIR /src/frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build


# ---------- Build ASP.NET backend ----------
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS backend
WORKDIR /src

COPY backend/PremsCart.Api/PremsCart.Api.csproj backend/PremsCart.Api/
RUN dotnet restore backend/PremsCart.Api/PremsCart.Api.csproj

COPY backend/PremsCart.Api/ backend/PremsCart.Api/

WORKDIR /src/backend/PremsCart.Api
RUN dotnet publish -c Release -o /out


# ---------- Final application ----------
FROM mcr.microsoft.com/dotnet/aspnet:10.0

WORKDIR /app

COPY --from=backend /out .
COPY --from=frontend /src/frontend/dist ./wwwroot

ENV ASPNETCORE_URLS=http://0.0.0.0:10000

EXPOSE 10000

ENTRYPOINT ["dotnet", "PremsCart.Api.dll"]